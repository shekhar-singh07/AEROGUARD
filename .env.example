# AEROGUARD Environment Configuration Template

# Database Configuration (PostgreSQL 12+)
# Format: postgresql://username:password@localhost:5432/aeroguard
# If omitted or unavailable, AEROGUARD automatically falls back to data/aeroguard.db (SQLite)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aeroguard

# Server Port
PORT=5000

# ML Microservice URL (FastAPI)
ML_SERVICE_URL=http://127.0.0.1:8000

# Security
JWT_SECRET=aeroguard_meteorological_intelligence_secure_key_2026

# Synoptic Cadence Settings
OBSERVATION_CADENCE_MINUTES=15
